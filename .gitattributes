# Text files are normalised to LF on commit and on checkout, on every
# platform. Without this, core.autocrlf=true on a Windows checkout rewrites
# them to CRLF, and anything in the repo that compares file content
# byte-for-byte (tests/make-icons.test.js is the one that found it) fails
# for a reason that has nothing to do with the code under test.
* text=auto eol=lf

*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.gitignore text eol=lf
.editorconfig text eol=lf
LICENSE text eol=lf

# Binary assets: never touched by line-ending normalisation, never diffed
# as text.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.woff2 binary
