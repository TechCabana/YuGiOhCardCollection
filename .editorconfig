# Spacing and line endings, stated once so an editor does not have to guess.
# https://editorconfig.org
root = true

[*]
charset = utf-8
# lf is what git stores. Windows checkouts see CRLF in the working copy because
# core.autocrlf converts on the way out — the committed bytes are still lf.
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# The repo's JSON is generated (data/cards.json, package-lock.json) and written
# with two spaces by the tools that produce it.
[*.{json,yml,yaml}]
indent_size = 2

# Trailing whitespace is significant in Markdown: two spaces is a line break.
[*.md]
trim_trailing_whitespace = false
